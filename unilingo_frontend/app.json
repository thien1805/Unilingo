{
  "expo": {
    "name": "Unilingo",
    "slug": "Unilingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./uni_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./uni_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unilingo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Unilingo uses the camera during IELTS Speaking Mock Test mode to monitor your speaking environment.",
        "NSMicrophoneUsageDescription": "Unilingo records your voice for speaking practice and mock test answers."
      }
    },
    "android": {
      "package": "com.unilingo.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./uni_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Unilingo to use your camera during IELTS Speaking Mock Test mode.",
          "microphonePermission": "Allow Unilingo to record your voice for speaking mock tests."
        }
      ]
    ]
  }
}
