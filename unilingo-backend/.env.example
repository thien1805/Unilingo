# ─── Application ───
APP_NAME=Unilingo
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_PREFIX=/api/v1
APP_PUBLIC_URL=https://<your-api>.up.railway.app

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://unilingo:unilingo_password@localhost:5432/unilingo_db
SQLALCHEMY_ECHO=false

# ─── Redis ───
# On Railway, use the private REDIS_URL only when API and Redis are in the same
# project/environment. If Redis is in another account/project, put that
# service's REDIS_PUBLIC_URL here instead.
REDIS_URL=redis://localhost:6379/0

# ─── JWT ───
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Firebase ───
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Google OAuth ───
# Put every client ID that may mint an ID token accepted by the backend.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=

# ─── AI Services ───
OPENAI_API_KEY=sk-...
GOOGLE_GEMINI_API_KEY=AIza...
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_SCORING_MODEL=llama-3.3-70b-versatile
GROQ_SCORING_MAX_TOKENS=900
AI_SCORING_DETAIL_MODE=fast
TTS_VOICE_NAME=en-US-AvaMultilingualNeural
TTS_VOICE_STYLE=chat
TTS_PROSODY_RATE=-3%
TTS_OUTPUT_FORMAT=audio-48khz-96kbitrate-mono-mp3

# ─── Storage (S3/MinIO) ───
# local for development, s3 for Railway Bucket / Cloudflare R2 / MinIO
AUDIO_STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=app/uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=unilingo-audio
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=auto
S3_AUDIO_PREFIX=practice-audio

# Railway Bucket example:
# AUDIO_STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=${{Bucket.ENDPOINT}}
# S3_ACCESS_KEY=${{Bucket.ACCESS_KEY_ID}}
# S3_SECRET_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# S3_BUCKET_NAME=${{Bucket.BUCKET}}
# S3_REGION=${{Bucket.REGION}}
# S3_ADDRESSING_STYLE=virtual

# Local MinIO example:
# AUDIO_STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=unilingo-audio
# S3_REGION=us-east-1
# S3_ADDRESSING_STYLE=path

# ─── Celery ───
# Use the same Railway public/private choice as REDIS_URL above.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Transactional Email ───
# Prefer SendGrid on Railway because Free/Trial/Hobby plans disable outbound SMTP.
# SENDGRID_FROM_EMAIL must be a verified sender/domain in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Unilingo
# Optional. If empty, backend falls back to APP_PUBLIC_URL/admin-web/uni_icon.png.
EMAIL_MASCOT_URL=

# Optional local/legacy SMTP fallback.
# Example for Gmail: use an App Password, not your normal account password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
