# ─── Application ───
APP_NAME=Unilingo
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://unilingo:unilingo_password@localhost:5432/unilingo_db

# ─── Redis ───
# On Railway, use the private REDIS_URL only when API and Redis are in the same
# project/environment. If Redis is in another account/project, put that
# service's REDIS_PUBLIC_URL here instead.
REDIS_URL=redis://localhost:6379/0

# ─── JWT ───
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Firebase ───
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── AI Services ───
OPENAI_API_KEY=sk-...
GOOGLE_GEMINI_API_KEY=AIza...
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
GROQ_API_KEY=

# ─── Storage (S3/MinIO) ───
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=unilingo-audio
S3_REGION=us-east-1

# ─── Celery ───
# Use the same Railway public/private choice as REDIS_URL above.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Transactional Email ───
# Prefer SendGrid on Railway because Free/Trial/Hobby plans disable outbound SMTP.
# SENDGRID_FROM_EMAIL must be a verified sender/domain in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Unilingo

# Optional local/legacy SMTP fallback.
# Example for Gmail: use an App Password, not your normal account password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
